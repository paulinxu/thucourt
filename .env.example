DEBUG=true
SECRET_KEY=local-development-only-change-before-deploying
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
# Leave empty for SQLite. Compose supplies its PostgreSQL URL.
DATABASE_URL=
DEMO_MODE=true
DEMO_PASSWORD=court-demo-2026
ADMIN_PASSWORD=change-this-admin-password
CELERY_TASK_ALWAYS_EAGER=true
REDIS_URL=redis://redis:6379/0
# demo = explicitly labelled offline rule-based plans; remote = real hosted inference
AI_PROVIDER=demo
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=
AI_DAILY_LIMIT=10
# Hard cap on total remote requests, including media and retries; no implicit spend.
AI_REMOTE_CALL_LIMIT=1000
AI_PROCESSOR_LABEL=已配置的模型服务商
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=http://localhost:5173/api/auth/wechat/callback/
SECURE_COOKIES=false
SECURE_SSL_REDIRECT=false
MEDIA_RETENTION_DAYS=30
